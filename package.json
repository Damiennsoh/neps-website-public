{
  "name": "neps-public-website",
  "version": "1.0.0",
  "private": true,
  "description": "Maintainable Next.js App Router conversion of the NEPS public website.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"app/**/*.{ts,tsx,css,html,json}\" \"public/**/*.{js,json}\" \"*.{md,json,ts}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css,html,json}\" \"public/**/*.{js,json}\" \"*.{md,json,ts}\""
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "prettier": "3.10.1",
    "serve": "14.2.8",
    "typescript": "5.9.2"
  }
}
